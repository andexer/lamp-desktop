{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lamp-desktop",
  "version": "1.0.1",
  "identifier": "com.andexer.lamp-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "lamp-desktop",
        "width": 1000,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
        "deb": {
            "depends": ["webkit2gtk4.1", "libappindicator3-1"]
        },
        "rpm": {
            "depends": ["webkit2gtk4.1", "docker", "docker-compose"]
        }
    }
  }
}
